# --- Postgres (users/roles/documents/pgvector/audit) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=internal_brain
POSTGRES_USER=internal_brain
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://internal_brain:change-me@localhost:5432/internal_brain

# --- Tencent Hunyuan (chat + embeddings) ---
# Standard Tencent Cloud API credentials (IAM), NOT the OpenAI-compatible
# hunyuan.cloud.tencent.com API key. Get these from the Tencent Cloud console
# (CAM > API Keys) or from the hackathon organizers' provided sandbox account.
HUNYUAN_APP_ID=
HUNYUAN_SECRET_ID=
HUNYUAN_SECRET_KEY=
HUNYUAN_CHAT_MODEL=hunyuan-turbo
# No embedding model var: the SDK's GetEmbedding takes only an Input string —
# there is no model to select, and it always returns 1024 dimensions.

# --- Router ---
# The distilled Router answers when its probability is at least this; below it the
# LLM Router decides. 0.8 is the lowest threshold with zero errors in 5-fold
# cross-validation on the training set (62.5% of questions decided without the LLM).
# Retrain with `python -m scripts.train_router_student` if the
# embedding model or the routes change.
ROUTER_STUDENT_ENABLED=true
ROUTER_STUDENT_MIN_CONFIDENCE=0.8

# --- Retrieval / verifier tuning (see CLAUDE.md for what these control) ---
RETRIEVAL_TOP_K=6
RETRIEVAL_MAX_HOPS=3
# No new retrieval hop STARTS after this many seconds, so a refusal takes at most
# the budget plus one hop. Keep budget + slowest hop below REFUSAL_DEADLINE_SECONDS.
# PER-HARDWARE, like the deadline: re-measure with evals/refusal_timing.py.
RETRIEVAL_HOP_BUDGET_SECONDS=2.0
# Cosine-similarity floor, SPECIFIC TO THE EMBEDDING MODEL AND THE CORPUS. It gates BOTH
# searches, the evidence search and the permission-conflict search, so a floor that is
# too high does two kinds of damage: answers go missing, and restricted matches stop
# registering as conflicts (the refusal is then recorded as "no evidence" and the
# access-gap report loses the signal).
# 30 Sep this was raised 0.55 -> 0.65 to stop off-topic chunks (scoring 0.51-0.65) being
# read by the model. It BROKE compliance recall: the AML documents a compliance officer
# needs score only 0.53-0.59 against their own question, so that officer was refused, and
# permission-conflict recall fell from 7/9 to 5/9. The sweep had only covered questions a
# support user can see. Reverted 4 Oct to 0.55, the calibrated value (7/9 conflicts
# raised, 0/13 false). Change it only with BOTH evals green, for BOTH personas:
#   evals/retrieval_threshold_sweep.py   recall, support and compliance questions
#   evals/conflict_calibration.py        conflict recall and false conflicts
RETRIEVAL_MIN_SCORE=0.55
VERIFIER_CONFIDENCE_THRESHOLD=0.6
PERMISSION_CONFLICT_SCORE_MARGIN=0.05

# Ask the source connector, at query time, whether it still grants access — for
# RESTRICTED documents only. Our permissions table is a mirror of the source ACLs and
# is only as fresh as the last ingest; this closes the window between a revocation
# upstream and that ingest. Off falls back to the mirror alone, which is where every
# other mirrored-ACL product sits. Costs one source lookup per restricted chunk.
SOURCE_RECHECK_ENABLED=true

# --- Timeouts ---
# Nothing may hang forever during a live demo. Generous enough for a 7B on a laptop,
# short enough that a wedged dependency shows as an error rather than a spinner.
# Load the model at startup rather than on the first question. Cold, the first
# request took 12.54s and the next 1.8s — and at a demo the first question is the
# one someone else asks. Fire and forget: a warm-up that fails is a slow first
# answer, never a failed start.
WARM_ON_STARTUP=true
# Ollama unloads an idle model after 5 minutes by default. During a demo that means
# the question asked after any pause pays the reload — 5.8s on a refusal whose
# deadline is 4.0s, which is an escape on the property being demonstrated.
OLLAMA_KEEP_ALIVE=30m

# --- Authentication ---
# The token is signed with this. Whoever holds it can mint a token for any user, so
# the committed default is for a local demo only. There is no refresh and no
# revocation list: a token is good until it expires, and the TTL is what bounds that.
AUTH_SECRET=demo-only-change-me
AUTH_TOKEN_TTL_MINUTES=720
# Failed sign-ins per email and per client before a lockout window (seconds).
# Counted for addresses that do not exist too, or the lockout itself would answer
# "does this account exist?".
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# /query, per caller. Every request counts the same whether it was answered or
# refused: a limiter that charged them differently would let a caller tell which one
# they got from their remaining allowance.
QUERY_MAX_PER_WINDOW=20
QUERY_WINDOW_SECONDS=60

LLM_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5

# --- Constant-time refusal ---
# Every refusal is held until this many seconds after the request arrived, so its
# timing can't reveal whether it was withheld or simply unanswerable.
# PER-HARDWARE: measured at 4.0s on an M3 Pro with qwen2.5:7b. Re-measure with
# evals/refusal_timing.py before trusting it on another machine.
REFUSAL_PADDING_ENABLED=true
REFUSAL_DEADLINE_SECONDS=4.0

# --- Knowledge-gap scan (GET /knowledge-gaps) ---
# Cosine floor for grouping unanswered questions into one gap. PER-MODEL, like
# RETRIEVAL_MIN_SCORE. Measured for mxbai-embed-large: same-topic questions score
# 0.81-0.94, different topics at most 0.71.
KNOWLEDGE_GAP_SIMILARITY=0.75

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Escalation notification (stub for MVP; leave blank) ---
ESCALATION_WEBHOOK_URL=

# --- LLM backend ---
# "ollama" (default), "hunyuan" or "fake".
# The hackathon provides CodeBuddy/WorkBuddy and Miora credits only — no Hunyuan
# API credentials — so ollama is what actually runs. Start it with `ollama serve`
# and `ollama pull qwen2.5:7b`. "fake" returns canned answers for tests; never
# record a demo on it.
LLM_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# 1024-dim, matching document_chunks.embedding. `ollama pull mxbai-embed-large`
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
